{
    "manifest_version": 3,
    "name": "YT_Playback_Control",
    "version": "1.7",
    "description": "Control YouTube and Vimeo playback using numpad shortcuts.",
    "icons": {
        "48": "icons/icon-48.png"
    },
    "content_scripts": [
        {
            "matches": ["*://*.youtube.com/*", "*://*.vimeo.com/*"],
            "js": ["main.js"],
            "run_at": "document_idle",
            "all_frames": true
        }
    ]
}
