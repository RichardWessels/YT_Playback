{
    "manifest_version": 3,
    "name": "YT_Playback_Control",
    "version": "1.7",
    "description": "Control YouTube and Vimeo playback using numpad shortcuts.",
    "browser_specific_settings": {
        "gecko": {
            "id": "{94a6a911-2069-4915-b893-72b30c54999f}",
            "data_collection_permissions": {
                "required": ["none"]
            }
        }
    },
    "icons": {
        "48": "icons/icon-48.png"
    },
    "content_scripts": [
        {
            "matches": ["*://*.youtube.com/*", "*://*.vimeo.com/*"],
            "js": ["main.js"],
            "run_at": "document_idle",
            "all_frames": true
        }
    ]
}
